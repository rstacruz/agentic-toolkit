@@ -0,0 +1,22 @@
+import { parseQuantity } from "./quantity";
+import type { Cart, CartLine } from "./types";
+
+export type BulkRow = { sku: string; qty: string };
+
+/**
+ * Adds every row from a pasted order sheet to the cart. Rows with an
+ * unparseable quantity are skipped and reported back to the caller.
+ */
+export function bulkAdd(cart: Cart, rows: BulkRow[]): { added: CartLine[]; skipped: BulkRow[] } {
+  const added: CartLine[] = [];
+  const skipped: BulkRow[] = [];
+  for (const row of rows) {
+    const quantity = parseQuantity(row.qty);
+    if (Number.isNaN(quantity)) {
+      skipped.push(row);
+      continue;
+    }
+    added.push(cart.addLine({ sku: row.sku, quantity }));
+  }
+  return { added, skipped };
+}
