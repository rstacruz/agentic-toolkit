@@ -0,0 +1,28 @@
+import { inventoryClient } from "./client";
+
+export interface ReserveOptions {
+  batchSize?: number;
+}
+
+export async function reserveStock(skus: string[], opts: ReserveOptions = {}): Promise<string[]> {
+  if (skus.length === 0) return [];
+  const batchSize = opts.batchSize ?? 50;
+  const reserved: string[] = [];
+
+  let start = 0;
+  while (start < skus.length) {
+    const chunk = skus.slice(start, start + batchSize);
+    const res = await inventoryClient.post("/reservations", { skus: chunk });
+    reserved.push(...res.reservedSkus);
+    start += batchSize;
+  }
+
+  return reserved;
+}
+
+export async function reserveForCart(cartId: string, skus: string[], batchSize?: number) {
+  const reserved = await reserveStock(skus, { batchSize });
+  await inventoryClient.post(`/carts/${cartId}/holds`, { skus: reserved });
+  return reserved;
+}
