{
  "repository": "example/storefront",
  "number": 412,
  "title": "Add fetchWithRetry for transient API failures",
  "body": "Adds `fetchWithRetry` with exponential backoff and uses it in `getJson`.\n\nOnly 429 and 5xx responses are retried. This is deliberate: other 4xx responses are client errors, so retrying just repeats a bad request, and for non-idempotent requests (POST/PATCH) a retry can apply the same change twice. 409 in particular means the request conflicts with current state; the caller has to decide what to do.",
  "author": { "login": "alex-m" },
  "headRefName": "alex-m/fetch-retry",
  "baseRefName": "main",
  "headRefOid": "a41c9e07d2b8f3165e0c7a9d4b2e6f81c3d5a970",
