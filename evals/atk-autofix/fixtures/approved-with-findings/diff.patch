new file mode 100644
index 0000000..3d8a2f1
--- /dev/null
+++ b/src/money/format.ts
@@ -0,0 +1,17 @@
+const SYMBOLS: Record<string, string> = { USD: "$", EUR: "€", GBP: "£" };
+
+/**
+ * Formats an amount in minor units (cents) for display, eg 1999 → "$19.99".
+ * Used for order totals and refund lines.
+ */
+export function formatPrice(cents: number, currency = "USD"): string {
+  const symbol = SYMBOLS[currency] ?? `${currency} `;
+  const abs = Math.abs(cents);
+  const whole = Math.floor(abs / 100);
+  const frac = String(abs % 100).padStart(2, "0");
+  return `${symbol}${whole.toLocaleString("en-US")}.${frac}`;
+}
+
+export function formatRefund(cents: number, currency = "USD"): string {
+  return formatPrice(-Math.abs(cents), currency);
+}
