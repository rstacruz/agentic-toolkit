diff --git a/src/account/profile-card.ts b/src/account/profile-card.ts
index 3d1c0a2..8f42b7e 100644
--- a/src/account/profile-card.ts
+++ b/src/account/profile-card.ts
@@ -1,18 +1,24 @@
 import type { User } from "./types";
 
 export type ProfileCard = {
   name: string;
   email: string;
+  location: string;
+  memberSince: string;
 };
 
 export function toProfileCard(user: User): ProfileCard {
   return {
     name: user.displayName ?? user.email,
     email: user.email,
+    location: `${user.address.city}, ${user.address.country}`,
+    memberSince: new Date(user.createdAt).getFullYear().toString(),
   };
 }
