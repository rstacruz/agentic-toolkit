@@ -0,0 +1,35 @@
+import type { Product } from "./types";
+
+const DEFAULT_TTL_MS = 5 * 60 * 1000;
+
+type Entry = { value: Product[]; expiresAt: number };
+
+/**
+ * Caches the product catalog in memory so request handlers don't each hit
+ * the catalog service.
+ */
+export class CatalogCache {
+  private entry: Entry | undefined;
+
+  constructor(
+    private readonly load: () => Promise<Product[]>,
+    private readonly ttlMs: number = DEFAULT_TTL_MS,
+  ) {}
+
+  async get(): Promise<Product[]> {
+    if (this.entry && this.entry.expiresAt > Date.now()) {
+      return this.entry.value;
+    }
+    return this.refresh();
+  }
+
+  private async refresh(): Promise<Product[]> {
+    const value = await this.load();
+    this.entry = { value, expiresAt: Date.now() + this.ttlMs };
+    return value;
+  }
+
+  invalidate(): void {
+    this.entry = undefined;
+  }
+}
